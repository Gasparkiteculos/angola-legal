# Template only. Replace YOUR_VERIFIED_DOMAIN and certificate paths after domain ownership
# and HTTPS certificates are configured. The application port must remain private.
limit_req_zone $binary_remote_addr zone=angola_api:10m rate=10r/s;
server {
    listen 80 default_server;
    server_name YOUR_VERIFIED_DOMAIN;
    return 301 https://$server_name$request_uri;
}
server {
    listen 443 ssl http2;
    server_name YOUR_VERIFIED_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/YOUR_VERIFIED_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_VERIFIED_DOMAIN/privkey.pem;
    client_max_body_size 1k;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=angola_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
