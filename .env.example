# Set only after choosing and verifying a domain you control.
ANGOLA_DOMAIN=legal.example.org
ANGOLA_PUBLIC_BASE_URL=https://legal.example.org
ANGOLA_THREADS=8
ANGOLA_CONNECTION_LIMIT=128
ANGOLA_CHANNEL_TIMEOUT=30
# Valid ranges: per minute 1-60000; burst 1-100000.
ANGOLA_RATE_LIMIT_PER_MINUTE=60
ANGOLA_RATE_LIMIT_BURST=120
# Production Compose sets the exact Caddy container address automatically.
# Never set this to a wildcard or a proxy you do not control.
ANGOLA_TRUSTED_PROXY=
